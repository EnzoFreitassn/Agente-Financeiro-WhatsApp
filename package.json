{
  "name": "agente-financeiro-wpp",
  "version": "0.1.0",
  "private": true,
  "description": "Agente financeiro pessoal via WhatsApp (Evolution API v2)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
